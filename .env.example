# Copy this file to .env and fill in the values you have.
# Nothing here is required to run the pipeline end-to-end -- every value
# below has a documented offline/skip fallback (see scripts/config.py).

# Generation (existing, from phase 1) -- get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Second hosted model for the generator ablation axis (Section 4.3/4.4), e.g. llama-3.1-8b-instant
SECONDARY_GENERATION_MODEL=

# Dense embeddings (new) -- leave unset to use the offline hash-embedding
# fallback (no semantic meaning, pipeline-plumbing only -- see
# scripts/retrieval/embed_api.py)
EMBEDDING_API_PROVIDER=offline
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=256

# Reranking (new) -- cross_encoder needs `pip install sentence-transformers torch`
# and huggingface.co access to download model weights; falls back to "off"
# automatically if unavailable.
RERANK_MODE=cross_encoder
RERANK_POOL_SIZE=20

MAX_ABLATION_CONFIGS=36
